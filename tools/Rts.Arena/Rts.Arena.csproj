<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Arena (docs/implementation/M8_ai_difficulty.md, 4.10, step 4): matches of bots against bots, no window, results as CSV. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on a newer runtime when only .NET 10 is installed. -->
    <RollForward>Major</RollForward>
    <AssemblyName>rts-arena</AssemblyName>
    <RootNamespace>Rts.Arena</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests count the harvesters destroyed through the same code as a match (step 9). -->
    <InternalsVisibleTo Include="Rts.Arena.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rts.Data/Rts.Data.csproj" />
    <ProjectReference Include="../../src/Rts.AI/Rts.AI.csproj" />
    <ProjectReference Include="../../src/Rts.MapGen/Rts.MapGen.csproj" />
  </ItemGroup>

</Project>
