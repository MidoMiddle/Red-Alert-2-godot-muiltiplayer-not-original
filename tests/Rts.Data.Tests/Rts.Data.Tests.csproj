<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on a newer runtime when only .NET 10 is installed (see docs/implementation/M0_foundation.md, 4.1). -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rts.Data/Rts.Data.csproj" />
  </ItemGroup>

  <!-- The relief test map (M7 step 2) and the ready maps (step 14) of the map tool, checked against the committed files. -->
  <ItemGroup>
    <Compile Include="../../tools/Rts.MapTool/ReliefTestMap.cs" Link="Tools/ReliefTestMap.cs" />
    <Compile Include="../../tools/Rts.MapTool/ReadyMaps.cs" Link="Tools/ReadyMaps.cs" />
    <!-- The end-to-end run of M3 step 14 on the real data. -->
    <Compile Include="../../tools/Rts.MapTool/EconomyRun.cs" Link="Tools/EconomyRun.cs" />
    <Compile Include="../../tools/Rts.MapTool/Skirmish.cs" Link="Tools/Skirmish.cs" />
  </ItemGroup>

  <!-- The M2 rules of the simulation tests: game/data must give the same rules (M3 step 4). -->
  <ItemGroup>
    <Compile Include="../Rts.Simulation.Tests/TestRules.cs" Link="Rules/TestRules.cs" />
  </ItemGroup>

  <!-- The map previews and the map catalog of the client (docs/implementation/M7_maps.md, step 10): pure, without Godot. -->
  <ItemGroup>
    <Compile Include="../../game/scripts/Maps/MapPreview.cs" Link="Client/MapPreview.cs" />
    <Compile Include="../../game/scripts/Maps/MapCatalog.cs" Link="Client/MapCatalog.cs" />
    <Compile Include="../../game/scripts/Terrain/LandColors.cs" Link="Client/LandColors.cs" />
  </ItemGroup>

  <!-- The matches the client sets up on the ready maps (docs/implementation/M5_first_bot.md, step 2): pure, without Godot. -->
  <ItemGroup>
    <Compile Include="../../game/scripts/Matches/MatchSetups.cs" Link="Client/MatchSetups.cs" />
    <Compile Include="../../game/scripts/Matches/SkirmishConfig.cs" Link="Client/SkirmishConfig.cs" />
  </ItemGroup>

</Project>
