<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on a newer runtime when only .NET 10 is installed (see docs/implementation/M0_foundation.md, 4.1). -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rts.Net/Rts.Net.csproj" />
  </ItemGroup>

  <!-- The rules and the reference match of the simulation tests, for matches in lockstep (docs/implementation/M9_network.md, step 3). -->
  <ItemGroup>
    <Compile Include="../Rts.Simulation.Tests/TestRules.cs" Link="Simulation/TestRules.cs" />
    <Compile Include="../Rts.Simulation.Tests/TestMapKinds.cs" Link="Simulation/TestMapKinds.cs" />
    <Compile Include="../Rts.Simulation.Tests/Determinism/ReferenceScenario.cs" Link="Simulation/ReferenceScenario.cs" />
  </ItemGroup>

</Project>
