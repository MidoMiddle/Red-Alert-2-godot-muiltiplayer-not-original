<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on a newer runtime when only .NET 10 is installed (see docs/implementation/M0_foundation.md, 4.1). -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The sound definitions are read with the same YAML library as the rules (Rts.Data), docs/implementation/M6_menus_skirmish.md, 4.8. -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rts.Simulation/Rts.Simulation.csproj" />
  </ItemGroup>

  <!-- ASCII test maps (docs/implementation/M2_unit_control.md, 4.3). -->
  <ItemGroup>
    <None Include="Maps/**/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The load scenario of the benchmarks (docs/implementation/M2_unit_control.md, 4.15), run here without timing. -->
  <ItemGroup>
    <Compile Include="../../src/Rts.Simulation.Benchmarks/LoadScenario.cs" Link="Benchmarks/LoadScenario.cs" />
    <Compile Include="../../src/Rts.Simulation.Benchmarks/BattleScenario.cs" Link="Benchmarks/BattleScenario.cs" />
    <Compile Include="../../src/Rts.Simulation.Benchmarks/BattleBases.cs" Link="Benchmarks/BattleBases.cs" />
    <Compile Include="../../src/Rts.Simulation.Benchmarks/LoadMapGenerator.cs" Link="Benchmarks/LoadMapGenerator.cs" />
    <Compile Include="../../src/Rts.Simulation.Benchmarks/SquadMap.cs" Link="Benchmarks/SquadMap.cs" />
  </ItemGroup>

  <!-- The trigonometry generator, to check the committed tables against it (docs/implementation/M2_unit_control.md, 4.1). -->
  <ItemGroup>
    <Compile Include="../../tools/Rts.TrigGen/TrigTableGenerator.cs" Link="Tools/TrigTableGenerator.cs" />
  </ItemGroup>

