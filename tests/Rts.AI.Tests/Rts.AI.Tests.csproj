<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on a newer runtime when only .NET 10 is installed (see docs/implementation/M0_foundation.md, 4.1). -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rts.AI/Rts.AI.csproj" />
    <ProjectReference Include="../../src/Rts.Data/Rts.Data.csproj" />
  </ItemGroup>

  <!-- The rules and the reference match of the simulation tests (docs/implementation/M5_first_bot.md, step 1). -->
  <ItemGroup>
    <Compile Include="../Rts.Simulation.Tests/TestRules.cs" Link="Simulation/TestRules.cs" />
    <Compile Include="../Rts.Simulation.Tests/Determinism/ReferenceScenario.cs" Link="Simulation/ReferenceScenario.cs" />
    <Compile Include="../Rts.Simulation.Tests/Matches/EventTally.cs" Link="Simulation/EventTally.cs" />
    <Compile Include="../Rts.Data.Tests/GameDataFiles.cs" Link="Data/GameDataFiles.cs" />
    <Compile Include="../../game/scripts/Matches/MatchSetups.cs" Link="Client/MatchSetups.cs" />
  </ItemGroup>

</Project>
