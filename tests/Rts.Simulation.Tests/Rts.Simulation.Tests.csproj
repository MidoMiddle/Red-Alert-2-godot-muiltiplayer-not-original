<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on a newer runtime when only .NET 10 is installed (see docs/implementation/M0_foundation.md, 4.1). -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rts.Simulation/Rts.Simulation.csproj" />
  </ItemGroup>

  <!-- ASCII test maps (docs/implementation/M2_unit_control.md, 4.3). -->
  <ItemGroup>
    <None Include="Maps/**/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The load scenario of the benchmarks (docs/implementation/M2_unit_control.md, 4.15), run here without timing. -->
  <ItemGroup>
    <Compile Include="../../src/Rts.Simulation.Benchmarks/LoadScenario.cs" Link="Benchmarks/LoadScenario.cs" />
    <Compile Include="../../src/Rts.Simulation.Benchmarks/LoadMapGenerator.cs" Link="Benchmarks/LoadMapGenerator.cs" />
    <Compile Include="../../src/Rts.Simulation.Benchmarks/SquadMap.cs" Link="Benchmarks/SquadMap.cs" />
  </ItemGroup>

  <!-- The trigonometry generator, to check the committed tables against it (docs/implementation/M2_unit_control.md, 4.1). -->
  <ItemGroup>
    <Compile Include="../../tools/Rts.TrigGen/TrigTableGenerator.cs" Link="Tools/TrigTableGenerator.cs" />
  </ItemGroup>

  <!-- The client rules without Godot types are tested here too (docs/implementation/M6_menus_skirmish.md, 6). -->
  <ItemGroup>
    <Compile Include="../../game/scripts/App/SettingsValues.cs" Link="Client/SettingsValues.cs" />
    <Compile Include="../../game/scripts/App/ResolutionChange.cs" Link="Client/ResolutionChange.cs" />
    <Compile Include="../../game/scripts/Input/ControlScheme.cs" Link="Client/Controls/ControlScheme.cs" />
    <Compile Include="../../game/scripts/Input/InputInterpreter.cs" Link="Client/Controls/InputInterpreter.cs" />
    <Compile Include="../../game/scripts/Input/KeyBindings.cs" Link="Client/Controls/KeyBindings.cs" />
    <Compile Include="../../game/scripts/Input/SelectionSet.cs" Link="Client/Controls/SelectionSet.cs" />
    <Compile Include="../../game/scripts/Input/BoxSelection.cs" Link="Client/Controls/BoxSelection.cs" />
    <Compile Include="../../game/scripts/Input/ControlGroups.cs" Link="Client/Controls/ControlGroups.cs" />
    <Compile Include="../../game/scripts/Input/CameraBookmarks.cs" Link="Client/Controls/CameraBookmarks.cs" />
    <Compile Include="../../game/scripts/Hud/MinimapImage.cs" Link="Client/Hud/MinimapImage.cs" />
    <Compile Include="../../game/scripts/Debug/OverlayColors.cs" Link="Client/Debug/OverlayColors.cs" />
    <Compile Include="../../game/scripts/Debug/TickHistory.cs" Link="Client/Debug/TickHistory.cs" />
    <Compile Include="../../game/scripts/Input/DoubleTap.cs" Link="Client/Controls/DoubleTap.cs" />
    <Compile Include="../../game/scripts/Input/OrderTargets.cs" Link="Client/Controls/OrderTargets.cs" />
    <Compile Include="../../game/scripts/Input/WaypointDraft.cs" Link="Client/Controls/WaypointDraft.cs" />
    <Compile Include="../../game/scripts/Input/CursorChoice.cs" Link="Client/Controls/CursorChoice.cs" />
    <Compile Include="../../game/scripts/App/Faction.cs" Link="Client/Faction.cs" />
    <Compile Include="../../game/scripts/Hud/SidebarLayout.cs" Link="Client/Hud/SidebarLayout.cs" />
    <Compile Include="../../game/scripts/Hud/CommandBarLayout.cs" Link="Client/Hud/CommandBarLayout.cs" />
    <Compile Include="../../game/scripts/Hud/MinimapMath.cs" Link="Client/Hud/MinimapMath.cs" />
    <Compile Include="../../game/scripts/Hud/HudFormat.cs" Link="Client/Hud/HudFormat.cs" />
    <Compile Include="../../game/scripts/Hud/SidebarModel.cs" Link="Client/Hud/SidebarModel.cs" />
    <Compile Include="../../game/scripts/Hud/SidebarGauges.cs" Link="Client/Hud/SidebarGauges.cs" />
    <Compile Include="../../game/scripts/Terrain/TerrainHeights.cs" Link="Client/Terrain/TerrainHeights.cs" />
    <Compile Include="../../game/scripts/Terrain/TerrainMesh.cs" Link="Client/Terrain/TerrainMesh.cs" />
    <Compile Include="../../game/scripts/Terrain/LandColors.cs" Link="Client/Terrain/LandColors.cs" />
    <Compile Include="../../game/scripts/Debug/PathText.cs" Link="Client/Debug/PathText.cs" />
    <Compile Include="../../game/scripts/Debug/UnitStateText.cs" Link="Client/Debug/UnitStateText.cs" />
    <Compile Include="../../game/scripts/Units/UnitFacing.cs" Link="Client/Units/UnitFacing.cs" />
  </ItemGroup>

</Project>
