<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Rts.Simulation</RootNamespace>
    <!-- Every API used in the simulation must be visible in the file that uses it. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Enables the banned-API analyzer, see Directory.Build.targets. -->
    <RtsDeterministic>true</RtsDeterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests may set up state directly; game code changes state only through the simulation. -->
    <InternalsVisibleTo Include="Rts.Simulation.Tests" />
    <!-- The tests of the bots build their scenes as the simulation tests do (docs/implementation/M5_first_bot.md, step 3). -->
    <InternalsVisibleTo Include="Rts.AI.Tests" />
    <!-- The benchmarks time the phases of a tick one by one (docs/implementation/M2_unit_control.md, 4.15). -->
    <InternalsVisibleTo Include="Rts.Simulation.Benchmarks" />
  </ItemGroup>

</Project>
