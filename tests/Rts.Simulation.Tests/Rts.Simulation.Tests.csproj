<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on a newer runtime when only .NET 10 is installed (see docs/implementation/M0_foundation.md, 4.1). -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rts.Simulation/Rts.Simulation.csproj" />
  </ItemGroup>

  <!-- The client rules without Godot types are tested here too (docs/implementation/M6_menus_skirmish.md, 6). -->
  <ItemGroup>
    <Compile Include="../../game/scripts/App/SettingsValues.cs" Link="Client/SettingsValues.cs" />
    <Compile Include="../../game/scripts/App/ResolutionChange.cs" Link="Client/ResolutionChange.cs" />
  </ItemGroup>

</Project>
