<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The network (docs/implementation/M9_network.md, 3): the protocol, the transports and the lockstep. It drives the simulation from
    outside and is not part of it, so the determinism rules do not apply (docs/implementation/conventions.md, 1); the commands it
    carries are those of the simulation, byte for byte. Nothing of Godot. LiteNetLib comes with step 8.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Rts.Net</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rts.Simulation/Rts.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rts.Net.Tests" />
  </ItemGroup>

</Project>
