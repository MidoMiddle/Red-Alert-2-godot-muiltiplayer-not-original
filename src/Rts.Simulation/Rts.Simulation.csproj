<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Rts.Simulation</RootNamespace>
    <!-- Every API used in the simulation must be visible in the file that uses it. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Enables the banned-API analyzer, see Directory.Build.targets. -->
    <RtsDeterministic>true</RtsDeterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests may set up state directly; game code changes state only through the simulation. -->
    <InternalsVisibleTo Include="Rts.Simulation.Tests" />
  </ItemGroup>

</Project>
